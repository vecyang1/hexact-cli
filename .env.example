# hexact-cli credentials — copy to ~/.config/hexact/credentials.env and chmod 600.
#
# Each product is independent; configure only the ones you own. Keys come from
# the API/Webhook section of each dashboard's settings. Hexometer's key is
# per-property, not per-account.
#
# NEVER commit a real key. This file is the template; the real one lives outside
# the repository.

HEXOWATCH_API_KEY=
HEXOMATIC_API_KEY=
HEXOMETER_API_KEY=

# --- Preferred for unattended use: 1Password references, not values ----------
# An op:// reference is a pointer, not a secret, so it is safe in config and CI.
# These take precedence over the file above but not over exported env vars.
#
# HEXOWATCH_OP_REF='op://Vault/Hexowatch API Key/credential'
# HEXOMATIC_OP_REF='op://Vault/Hexomatic API Key/credential'
# HEXOMETER_OP_REF='op://Vault/Hexometer API Key/credential'
#
# Override the executable used to resolve them (default: `op`). Useful when the
# vault is reached through a service-account wrapper rather than the stock CLI.
# HEXACT_OP_CMD='op'
